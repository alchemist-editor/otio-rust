# Code generated by otio-sdk-gen from crates/otio-capi. DO NOT EDIT.
#
# Builds the library, and a test program beside it, against the Rust library
# in `lib/`. See README.md for how that gets there.
#
#     make          # the static library, in build/libOpenTimelineIO.a
#     make check    # build and run the tests
#     make clean

UNAME := $(shell uname -s)

# Objective-C here is what clang speaks: GCC's front end is a decade behind it
# and does not know `@autoreleasepool`. Only make's own default is replaced, so
# `make CC=...` still decides.
ifeq ($(origin CC),default)
    CC := clang
endif

SOURCES := $(sort $(wildcard src/*.m))
OBJECTS := $(patsubst src/%.m,build/%.o,$(SOURCES))
TEST_SOURCES := $(sort $(wildcard tests/*.m))
TEST_OBJECTS := $(patsubst tests/%.m,build/tests/%.o,$(TEST_SOURCES))

LIBRARY := build/libOpenTimelineIO.a
TESTS := build/tests/tests

# `otio.h` is the C interface this SDK is generated from; it is read out of
# the crate rather than copied, so the two cannot drift.
CPPFLAGS += -Iinclude -Isrc -I../../crates/otio-capi/include
OBJCFLAGS += -std=c11 -Wall -Wextra -Werror -fPIC
LDLIBS += -L lib -lotio

ifeq ($(UNAME),Darwin)
    # Apple's runtime has ARC, and Foundation is a framework.
    OBJCFLAGS += -fobjc-arc
    LDLIBS += -framework Foundation
else
    # GNUstep's legacy runtime has no ARC, so the same sources build under
    # manual retain and release; everything this library owns says so through
    # the macros in src/OTIOPrivate.h.
    #
    # GNUstep's own headers arrive on the include path rather than the system
    # one, so -Werror would fail the build on warnings that are theirs; the two
    # they raise are turned off rather than the guarantee being given up.
    OBJCFLAGS += $(shell gnustep-config --objc-flags)
    OBJCFLAGS += -Wno-expansion-to-defined -Wno-unused-parameter
    LDLIBS += $(shell gnustep-config --base-libs)
    #
    # Debian and Ubuntu ship the Objective-C runtime with GCC rather than on
    # the system paths: `objc/objc.h` sits in GCC's include directory and
    # `libobjc.so` beside GCC's own libraries, both from `libobjc-N-dev`.
    # Only `libobjc.so.4` is where `gnustep-config --base-libs` points, and
    # that is a runtime name the linker will not resolve `-lobjc` against, so
    # without this the sources compile and then fail to link. Both paths are
    # asked of GCC itself, so this holds whichever version the distribution
    # has, and clang is not relied on to have found a GCC installation.
    GCC_INCLUDE := $(shell gcc -print-file-name=include 2>/dev/null)
    ifneq ($(wildcard $(GCC_INCLUDE)/objc/objc.h),)
        OBJCFLAGS += -isystem $(GCC_INCLUDE)
    endif
    OBJC_RUNTIME := $(shell gcc -print-file-name=libobjc.so 2>/dev/null)
    ifneq ($(filter /%,$(OBJC_RUNTIME)),)
        LDFLAGS += -L$(patsubst %/,%,$(dir $(OBJC_RUNTIME)))
    endif
endif

.PHONY: all check clean
all: $(LIBRARY)

$(LIBRARY): $(OBJECTS)
	@mkdir -p $(dir $@)
	$(AR) rcs $@ $(OBJECTS)

build/%.o: src/%.m
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(OBJCFLAGS) -c $< -o $@

build/tests/%.o: tests/%.m
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(OBJCFLAGS) -c $< -o $@

$(TESTS): $(TEST_OBJECTS) $(LIBRARY)
	@mkdir -p $(dir $@)
	$(CC) $(TEST_OBJECTS) $(LIBRARY) $(LDFLAGS) $(LDLIBS) -o $@

check: $(TESTS)
	$(TESTS)

clean:
	rm -rf build
