{
  "name": "@alchemist-edit/otio",
  "version": "0.1.0",
  "description": "OpenTimelineIO for the browser and for Node, on a Rust core compiled to WebAssembly.",
  "license": "Apache-2.0",
  "keywords": [
    "opentimelineio",
    "otio",
    "timeline",
    "editorial",
    "edl",
    "cmx3600",
    "ale",
    "fcpxml",
    "final-cut-pro",
    "webassembly",
    "wasm"
  ],
  "homepage": "https://otio-rust-docs.vercel.app",
  "bugs": {
    "url": "https://github.com/alchemist-editor/otio-rust/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemist-editor/otio-rust.git",
    "directory": "crates/otio-wasm/ts"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "default": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      }
    },
    "./wasm": "./dist/otio_wasm.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "build": "npm run wasm && tsc --build tsconfig.build.json && node scripts/copy-wasm.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run build:test && node --test \"dist-test/test/*.test.js\"",
    "test:browser": "npm run build && npm run build:test && playwright test",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('dist-test',{recursive:true,force:true})\"",
    "build:test": "tsc -p tsconfig.json && node scripts/copy-wasm.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "prepack": "node scripts/prepack.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.5.0",
    "typescript": "^5.6.0"
  }
}
