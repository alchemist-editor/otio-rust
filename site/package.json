{
  "name": "@otio/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The OpenTimelineIO for Rust documentation site.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
